{
  "name": "polarization-lab",
  "private": true,
  "version": "1.4.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 8080\" \"sleep 2 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder --win portable",
    "electron:start": "electron .",
    "shortcut": "node create-shortcut.cjs"
  },
  "build": {
    "appId": "com.polarization-lab.app",
    "productName": "偏振光虚拟实验系统",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
